PackageIdentifier: Deuk1718.GASOptimizer
PackageVersion: {{VERSION}}
Platform:
  - Windows.Desktop
MinimumOSVersion: 10.0.17763.0
InstallerType: zip
NestedInstallerType: portable
NestedInstallerFiles:
  - RelativeFilePath: gas-optimizer-v{{VERSION}}\bin\gas-optimizer.cmd
    PortableCommandAlias: gas-optimizer
Commands:
  - gas-optimizer
UpgradeBehavior: uninstallPrevious
Installers:
  - Architecture: neutral
    InstallerUrl: {{WINDOWS_URL}}
    InstallerSha256: {{WINDOWS_SHA256_UPPER}}
ManifestType: installer
ManifestVersion: 1.6.0
